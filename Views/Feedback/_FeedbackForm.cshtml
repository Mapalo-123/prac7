@model Prac7.Models.Feedback

<div class="feedback-card">

    @using (Html.BeginForm("Index", "Feedback", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            @Html.LabelFor(m => m.Name)
            @Html.TextBoxFor(m => m.Name,
                new { @class = "form-control", placeholder = "Enter your name" })
            @Html.ValidationMessageFor(m => m.Name, "",
                new { @class = "error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Email)
            @Html.TextBoxFor(m => m.Email,
                new { @class = "form-control", placeholder = "Enter your email" })
            @Html.ValidationMessageFor(m => m.Email, "",
                new { @class = "error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Subject)
            @Html.TextBoxFor(m => m.Subject,
                new { @class = "form-control", placeholder = "Enter subject" })
            @Html.ValidationMessageFor(m => m.Subject, "",
                new { @class = "error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Rating)
            @Html.DropDownListFor(m => m.Rating,
                new SelectList(new[]
                {
                    new { Value = "", Text = "Select Rating" },
                    new { Value = "Excellent", Text = "Excellent" },
                    new { Value = "Good", Text = "Good" },
                    new { Value = "Average", Text = "Average" },
                    new { Value = "Poor", Text = "Poor" }
                }, "Value", "Text"),
                new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Rating, "",
                new { @class = "error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Message)
            @Html.TextAreaFor(m => m.Message,
                new
                     {
                         @class = "form-control",
                         rows = "4",
                      placeholder = "Write your feedback here"
                     })
            @Html.ValidationMessageFor(m => m.Message, "",
                new { @class = "error" })
        </div>

        <button type="submit" class="submit-button">
            Submit Feedback
        </button>
    }
</div>
